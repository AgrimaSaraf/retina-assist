{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetinaAssist de-identified visit record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "research_id": {
      "type": "string"
    },
    "age_band": {
      "enum": [
        "0-17",
        "18-39",
        "40-59",
        "60+"
      ]
    },
    "visit_type": {
      "enum": [
        "routine",
        "retina",
        "glaucoma",
        "post_op",
        "other"
      ]
    },
    "previous_missed_visits": {
      "type": "integer",
      "minimum": 0
    },
    "lead_time_days": {
      "type": "integer",
      "minimum": 0
    },
    "recommended_followup_days": {
      "type": "integer",
      "minimum": 1
    },
    "contact_available": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "followup_recommended": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "missed_followup": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "days_late": {
      "type": "integer",
      "minimum": 0
    }
  }
}